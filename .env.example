# ─────────────────────────────────────────────────────────────
# Supabase (required for Phase 0+)
# Get from https://app.supabase.com/project/_/settings/api
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─────────────────────────────────────────────────────────────
# Database (required for Drizzle migrations + queries)
# Get from https://app.supabase.com/project/_/settings/database
# Use the "Connection pooling" string with sslmode=require
# ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@host:6543/postgres?sslmode=require

# ─────────────────────────────────────────────────────────────
# RAWG API (required for Phase 1+ — game catalog)
# Free key from https://rawg.io/apidocs
# ─────────────────────────────────────────────────────────────
RAWG_API_KEY=your-rawg-api-key

# ─────────────────────────────────────────────────────────────
# Upstash Redis (Phase 1+ — caches RAWG search responses + details)
# Free tier: 10K commands/day, 256MB. Pick region matching your Supabase.
# Create at https://console.upstash.com (Vercel Marketplace also works)
# ─────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# ─────────────────────────────────────────────────────────────
# AI Providers (required for Phase 2+ — AI reviews + recs)
# Tier 1: Cerebras (1M tokens/day free) — https://cloud.cerebras.ai
# Tier 2: Groq (14,400 RPD free) — https://console.groq.com
# Tier 3: Cloudflare Workers AI (10K Neurons/day free) — https://dash.cloudflare.com
# Overflow: DeepSeek V3 paid (~$0.14/$0.28 per M tokens) — https://platform.deepseek.com
# Added for /play-next redesign (2026-05-15):
# Gemini 2.0 Flash (1500 req/day free) — https://aistudio.google.com/apikey
# ─────────────────────────────────────────────────────────────
CEREBRAS_API_KEY=
GROQ_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# ─────────────────────────────────────────────────────────────
# Email + digest cron (Phase 5)
# Resend handles digest delivery + future transactional email.
# RESEND_DIGEST_FROM_ADDRESS must be on a verified Resend sender
# domain; defaults to digest@letterboxd-for-games.vercel.app.
# CRON_SECRET must match the value stored in Supabase Vault as
# 'phase5_cron_secret' (pg_cron reads it at fire time and sends
# it as the X-Cron-Secret header to /api/internal/digest/run).
# UNSUBSCRIBE_SECRET (≥32 chars) signs digest-unsubscribe JWTs via
# jose HS256. Generate fresh secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# https://resend.com
# ─────────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_DIGEST_FROM_ADDRESS=
CRON_SECRET=
UNSUBSCRIBE_SECRET=

# ─────────────────────────────────────────────────────────────
# Moderation (Phase 5)
# Comma-separated UUIDs from auth.users.id. Members see
# /admin/reports; everyone else gets 404.
# ─────────────────────────────────────────────────────────────
ADMIN_USER_IDS=

# ─────────────────────────────────────────────────────────────
# Library imports (Phase 3+)
# Steam Web API: https://steamcommunity.com/dev/apikey (admin-only; user does not paste their own)
# Supabase Functions URL: https://<project>.supabase.co/functions/v1
# Encryption key: base64-encoded 32 bytes — generate with
#   `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
# ─────────────────────────────────────────────────────────────
STEAM_API_KEY=
SUPABASE_FUNCTIONS_URL=
IMPORT_ENCRYPTION_KEY=

# ─────────────────────────────────────────────────────────────
# IGDB (mechanics + vocab refresh — Phase 4+)
# Twitch OAuth client-credentials flow gates the IGDB v4 API:
# register an app at https://dev.twitch.tv/console/apps to mint a
# Client ID + Secret pair. The Edge Function `_shared/igdb-engine`
# and lib/igdb/* both read these; scripts/refresh-igdb-vocab.ts
# also requires them. App-access-tokens are cached in app_secrets
# so a single ID+Secret covers Next, scripts, and Edge runtimes.
# ─────────────────────────────────────────────────────────────
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────
# OpenAI (mechanics backfill script only — not in serving path)
# Used by scripts/backfill-mechanics-ai.ts to extract mechanic
# tags for catalog rows missing IGDB coverage. Tier 1 carries a
# 10K-RPD ceiling on gpt-4o-mini; budget overnight runs accordingly.
# Get a key from https://platform.openai.com/api-keys
# ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ─────────────────────────────────────────────────────────────
# SteamGridDB (poster long-tail fallback — optional)
# When set, lib/games/poster-source.ts falls back to SteamGridDB
# after Steam CDN misses (covers non-Steam titles). Free key:
# https://www.steamgriddb.com/profile/preferences/api
# ─────────────────────────────────────────────────────────────
SGDB_API_KEY=

# ─────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
